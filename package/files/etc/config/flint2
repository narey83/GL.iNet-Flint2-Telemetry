config agent 'main'
	option enabled '0'
	option format 'otlp_http_json'
	option endpoint 'https://collector.example.invalid/v1/logs'
	option ca_file '/etc/ssl/certs/ca-certificates.crt'
	option interval '30'
	option inventory_interval '300'
	option max_queue '2048'
	option metrics_enabled '1'
	option metric_events_enabled '0'
	option router_logs '1'
	option flow_capture '1'
	option firewall_events '1'
	option wan_interface 'auto'
	list flow_lan_interface 'br-lan'
	list flow_lan_interface 'br-guest'
	list flow_lan_interface 'br-iot'
	option metrics_endpoint 'https://collector.example.invalid/v1/metrics'
	option metrics_max_queue '8'
	list interface 'br-lan'
